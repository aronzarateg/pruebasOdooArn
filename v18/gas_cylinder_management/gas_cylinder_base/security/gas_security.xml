<odoo>
  <record id="group_gas_cylinder_user" model="res.groups">
    <field name="name">Gas Cylinder User</field>
  </record>
  <record id="group_gas_cylinder_manager" model="res.groups">
    <field name="name">Gas Cylinder Manager</field>
    <field name="implied_ids" eval="[(4, ref('group_gas_cylinder_user'))]"/>
  </record>
  <record id="rule_gas_cylinder_company" model="ir.rule">
    <field name="name">Gas cylinders: allowed companies</field>
    <field name="model_id" ref="model_gas_cylinder"/>
    <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    <field name="groups" eval="[(4, ref('group_gas_cylinder_user'))]"/>
  </record>
  <record id="rule_gas_content_company" model="ir.rule"><field name="name">Gas content: companies</field><field name="model_id" ref="model_gas_cylinder_content"/><field name="domain_force">[('company_id','in',company_ids)]</field><field name="groups" eval="[(4,ref('group_gas_cylinder_user'))]"/></record>
</odoo>
