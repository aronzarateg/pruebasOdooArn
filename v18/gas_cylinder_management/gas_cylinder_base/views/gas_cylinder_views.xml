<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gas_cylinder_list" model="ir.ui.view">
        <field name="name">gas.cylinder.list</field>
        <field name="model">gas.cylinder</field>
        <field name="arch" type="xml">
            <list string="Cilindros">
                <field name="serial_number"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="capacity"/>
                <field name="content_total_quantity"
                       optional="show"/>
                <field name="content_free_capacity"
                       optional="show"/>
                <field name="ownership_type"/>
                <field name="owner_id" optional="hide"/>
                <field name="company_id"
                       groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_gas_cylinder_form" model="ir.ui.view">
        <field name="name">gas.cylinder.form</field>
        <field name="model">gas.cylinder</field>
        <field name="arch" type="xml">
            <form string="Cilindro">
                <sheet>

                    <group string="Información del cilindro">
                        <group>
                            <field name="product_id"
                                   options="{'no_create': True}"/>

                            <field name="lot_id"
                                   domain="[('product_id', '=', product_id), ('company_id', 'in', [False, company_id])]"
                                   options="{'no_create': True, 'no_create_edit': True}"/>

                            <field name="serial_number"
                                   readonly="lot_id != False"/>

                            <field name="capacity"/>
                        </group>

                        <group>
                            <field name="ownership_type"/>

                            <field name="owner_id"
                                   invisible="ownership_type != 'third_party'"
                                   required="ownership_type == 'third_party'"/>

                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <group string="Resumen de contenido"
                           invisible="not id">
                        <group>
                            <field name="content_total_quantity"
                                   readonly="1"/>
                            <field name="content_available_quantity"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="content_free_capacity"
                                   readonly="1"/>
                            <field name="content_occupation_pct"
                                   readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Gases compatibles">
                            <group string="Productos de gas permitidos">
                                <field name="allowed_gas_product_ids"
                                       widget="many2many_tags"
                                       domain="[('product_tmpl_id.gas_product_type', '=', 'gas')]"
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                            </group>
                        </page>

                        <page string="Contenido actual">
                            <field name="content_ids"
                                   readonly="1">
                                <list create="0"
                                      edit="0"
                                      delete="0">
                                    <field name="gas_product_id"
                                           string="Gas"/>
                                    <field name="quantity"
                                           string="Cantidad física"/>
                                    <field name="available_quantity"
                                           string="Disponible"/>
                                    <field name="uom_id"
                                           string="UdM"/>
                                </list>
                            </field>
                        </page>

                        <page string="Historial de movimientos">
                            <field name="content_move_ids"
                                   readonly="1">
                                <list create="0"
                                      edit="0"
                                      delete="0"
                                      default_order="id desc">
                                    <field name="date"
                                           string="Fecha"/>
                                    <field name="gas_product_id"
                                           string="Gas"/>
                                    <field name="quantity_delta"
                                           string="Movimiento físico"/>
                                    <field name="available_delta"
                                           string="Movimiento disponible"/>
                                    <field name="stock_move_id"
                                           string="Movimiento de stock"/>
                                    <field name="note"
                                           string="Observación"/>
                                </list>
                            </field>
                        </page>

                        <page string="Observaciones">
                            <field name="notes"/>
                        </page>

                    </notebook>

                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_gas_cylinders"
            model="ir.actions.act_window">
        <field name="name">Cilindros</field>
        <field name="res_model">gas.cylinder</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
               eval="[(5, 0, 0),
                      (0, 0, {'view_mode': 'list',
                              'view_id': ref('view_gas_cylinder_list')}),
                      (0, 0, {'view_mode': 'form',
                              'view_id': ref('view_gas_cylinder_form')})]"/>
    </record>

</odoo>
