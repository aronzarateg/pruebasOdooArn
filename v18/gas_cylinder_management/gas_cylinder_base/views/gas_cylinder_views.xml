<odoo>
    <record id="view_gas_cylinder_list" model="ir.ui.view">
        <field name="name">gas.cylinder.list</field>
        <field name="model">gas.cylinder</field>
        <field name="arch" type="xml">
            <list string="Cylinders">
                <field name="serial_number"/>
                <field name="product_id"/>
                <field name="capacity"/>
                <field name="ownership_type"/>
                <field name="owner_id"/>
                <field name="lot_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_gas_cylinder_form" model="ir.ui.view">
        <field name="name">gas.cylinder.form</field>
        <field name="model">gas.cylinder</field>
        <field name="arch" type="xml">
            <form string="Cylinder">
                <sheet>
                    <group>
                        <group>
                            <field name="serial_number"/>
                            <field name="product_id"/>
                            <field name="lot_id"
                                   domain="[('product_id', '=', product_id)]"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="ownership_type"/>
                            <field name="owner_id" invisible="ownership_type != 'third_party'"/>
                            <field name="company_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_gas_cylinders" model="ir.actions.act_window">
        <field name="name">Cylinders</field>
        <field name="res_model">gas.cylinder</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
               eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_gas_cylinder_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('view_gas_cylinder_form')})]"/>
    </record>
</odoo>
