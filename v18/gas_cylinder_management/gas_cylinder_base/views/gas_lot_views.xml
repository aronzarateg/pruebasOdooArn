<odoo>
    <record id="view_gas_lot_form_inherit" model="ir.ui.view">
        <field name="name">stock.lot.form.gas.inherit</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="inside">
                <group>
                    <field name="lot_supplier"/>
                    <field name="code_supplier"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_gas_lots" model="ir.actions.act_window">
        <field name="name">Series de cilindros</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="domain">
            [('product_id.product_tmpl_id.gas_product_type', '=', 'cylinder')]
        </field>
    </record>
</odoo>