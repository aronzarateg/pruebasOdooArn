<odoo>
    <!-- Heredar formulario estándar de productos -->
    <record id="view_gas_product_template_form" model="ir.ui.view">
        <field name="name">gas.product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group" position="inside">
                <group name="group_general">
                    <field name="gas_product_type"/>
                    <field name="cylinder_capacity" invisible="gas_product_type != 'cylinder'"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Heredar listado estándar de productos -->
    <record id="view_gas_product_template_list" model="ir.ui.view">
        <field name="name">gas.product.template.list.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="gas_product_type" optional="show"/>
                <field name="cylinder_capacity" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Acción para mostrar productos de gases y cilindros -->
    <record id="action_gas_products" model="ir.actions.act_window">
        <field name="name">Productos de gases y cilindros</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('gas_product_type', '!=', 'none')]</field>
        <field name="context">{'default_gas_product_type': 'cylinder'}</field>
    </record>
</odoo>