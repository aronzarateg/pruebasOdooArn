
<odoo>
    <record id="view_gas_config_list" model="ir.ui.view">
        <field name="name">gas.cylinder.operation.config.list</field>
        <field name="model">gas.cylinder.operation.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
                <field name="company_id"/>
                <field name="warehouse_id"/>
                <field name="operation_type"/>
                <field name="picking_type_id"/>
                <field name="location_src_id"/>
                <field name="location_dest_id"/>
            </list>
        </field>
    </record>

    <record id="view_gas_config_form" model="ir.ui.view">
        <field name="name">gas.cylinder.operation.config.form</field>
        <field name="model">gas.cylinder.operation.config</field>
        <field name="arch" type="xml">
            <form string="Configuración de operaciones">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="company_id"/>
                        <field name="warehouse_id"/>
                        <field name="operation_type"/>
                    </group>

                    <group string="Transferencia de salida">
                        <field name="picking_type_id"/>
                        <field name="location_src_id"/>
                        <field name="location_dest_id"/>
                    </group>

                    <group string="Transferencia de retorno"
                           invisible="operation_type != 'supplier_refill'">
                        <field name="return_picking_type_id"
                               required="operation_type == 'supplier_refill'"/>
                        <field name="return_location_src_id"
                               required="operation_type == 'supplier_refill'"/>
                        <field name="return_location_dest_id"
                               required="operation_type == 'supplier_refill'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_gas_configs" model="ir.actions.act_window">
        <field name="name">Configuración de operaciones</field>
        <field name="res_model">gas.cylinder.operation.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
