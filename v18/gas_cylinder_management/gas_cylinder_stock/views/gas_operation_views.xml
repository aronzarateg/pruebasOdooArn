<odoo>
    <record id="view_gas_operation_list" model="ir.ui.view">
        <field name="name">gas.cylinder.operation.list</field>
        <field name="model">gas.cylinder.operation</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="operation_type"/>
                <field name="partner_id"/>
                <field name="company_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_gas_operation_form" model="ir.ui.view">
        <field name="name">gas.cylinder.operation.form</field>
        <field name="model">gas.cylinder.operation</field>
        <field name="arch" type="xml">
            <form string="Operación de gases">
                <header>
                    <button name="action_ready"
                            type="object"
                            string="Preparar"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_prepare_return"
                            type="object"
                            string="Preparar retorno"
                            class="btn-secondary"
                            invisible="state != 'ready'
                       or operation_type != 'supplier_refill'
                       or return_picking_id"/>
                    <button name="action_done"
                            type="object"
                            string="Finalizar recarga"
                            class="btn-primary"
                            confirm="¿Desea finalizar la recarga y registrar el contenido de gas en el kardex?"
                            invisible="state != 'ready'
                               or operation_type != 'supplier_refill'
                               or not outgoing_picking_id
                               or not return_picking_id"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancelar"
                            invisible="state not in ('draft', 'ready')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,ready,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Información general">
                            <field name="name" readonly="1"/>
                            <field name="operation_type" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'"/>
                            <field name="config_id" readonly="state != 'draft'"
                                   domain="[('operation_type', '=', operation_type), ('company_id', '=', company_id)]"/>
                        </group>

                        <group string="Transferencias">
                            <field name="outgoing_picking_id"
                                   readonly="1"/>
                            <field name="return_picking_id"
                                   readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Cilindros">
                            <field name="line_ids" readonly="state in ('done', 'cancel')">
                                <list editable="bottom">
                                    <field name="cylinder_id" string="Cilindro" readonly="parent.state != 'draft'"/>

                                    <field name="gas_product_id"
                                           string="Producto de gas"
                                           domain="[('product_tmpl_id.gas_product_type', '=', 'gas')]"
                                           readonly="parent.state != 'draft'"
                                           required="1"/>

                                    <field name="quantity" string="Gas planificado (m³)"
                                           readonly="parent.state != 'draft'"/>
                                    <field name="quantity_received" string="Gas recibido (m³)"
                                           readonly="parent.state != 'ready'"/>
                                    <field name="lot_supplier" string="Lote del proveedor"
                                           readonly="parent.state not in ('draft', 'ready')"/>
                                    <field name="code_supplier" string="Código del proveedor"
                                           readonly="parent.state not in ('draft', 'ready')"/>
                                    <field name="cylinder_capacity" readonly="1"/>
                                    <field name="current_content" readonly="1"/>
                                    <field name="available_capacity" readonly="1"/>
                                    <field name="is_full"
                                           widget="boolean_toggle"
                                           readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documentos">
                            <field name="picking_ids" widget="many2many_tags" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_gas_operations" model="ir.actions.act_window">
        <field name="name">Operaciones de gases</field>
        <field name="res_model">gas.cylinder.operation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
