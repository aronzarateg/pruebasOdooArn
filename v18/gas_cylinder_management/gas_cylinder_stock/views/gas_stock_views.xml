
<odoo>
    <record id="view_gas_moves_list" model="ir.ui.view">
        <field name="name">gas.cylinder.content.move.list</field>
        <field name="model">gas.cylinder.content.move</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="date"/>
                <field name="cylinder_id"/>
                <field name="gas_product_id"/>
                <field name="quantity_delta"/>
                <field name="available_delta"/>
                <field name="operation_id"/>
                <field name="stock_move_id"/>
            </list>
        </field>
    </record>

    <record id="action_gas_moves" model="ir.actions.act_window">
        <field name="name">Kardex de contenido</field>
        <field name="res_model">gas.cylinder.content.move</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_gas_operations"
              name="Operaciones"
              parent="gas_cylinder_base.menu_gas_root"
              action="action_gas_operations"
              sequence="30"/>

    <menuitem id="menu_gas_moves"
              name="Kardex de contenido"
              parent="gas_cylinder_base.menu_gas_root"
              action="action_gas_moves"
              sequence="40"/>

    <menuitem id="menu_gas_configs"
              name="Tipos y ubicaciones"
              parent="gas_cylinder_base.menu_gas_configuration"
              action="action_gas_configs"
              sequence="30"/>
</odoo>
