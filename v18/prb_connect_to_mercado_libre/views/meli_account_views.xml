<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM -->
    <record id="view_meli_account_form" model="ir.ui.view">
        <field name="name">meli.account.form</field>
        <field name="model">meli.account</field>
        <field name="arch" type="xml">
            <form string="Mercado Libre">
                <header>
                    <button name="action_connect_meli"
                            string="Conectar Mercado Libre"
                            type="object"
                            class="btn-primary"/>
                    <button name="action_test_connection"
                            string="Probar conexión"
                            type="object"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <field name="image_1920"
                           widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'image_1920'}"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Cuenta Mercado Libre"/>
                        </h1>
                    </div>

                    <group name="meli_header">
                        <group string="Configuración API">
                            <field name="active"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="redirect_uri"/>
                            <field name="site_id"/>
                        </group>

                        <group string="Tokens">
                            <field name="meli_user_id" readonly="1"/>
                            <field name="access_token" password="True" readonly="1"/>
                            <field name="refresh_token" password="True" readonly="1"/>
                            <field name="token_expires_in" readonly="1"/>
                            <field name="token_scope" readonly="1"/>
                            <field name="token_type" readonly="1"/>

                            <field name="token_last_update" readonly="1"/>
                            <field name="token_response" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Otra información"
                              name="other_information">
                            <group>
                                <group string="Sincronizar órdenes">
                                    <button name="action_sync_orders"
                                            string="Sincronizar órdenes"
                                            type="object"
                                            class="btn-secondary"
                                            invisible="not active"/>
                                </group>

                                <group string="Sincronizar publicaciones">
                                    <!--<button name="action_sync_items"
                                            string="Sincronizar publicaciones"
                                            type="object"
                                            class="btn-secondary"
                                            invisible="not active"/>-->
                                </group>

                                <group string="Categorías y atributos">
                                   <!--

                                    <button name="action_sync_meli_categories"
                                            string="Sincronizar categorías"
                                            type="object"
                                            class="btn-primary"
                                            invisible="not active"/>



                                    <button name="action_sync_meli_category_attributes"
                                            string="Sincronizar atributos"
                                            type="object"
                                            invisible="not active"/>

                                    <button name="action_sync_meli_brands"
                                            string="Sincronizar marcas"
                                            type="object"
                                            invisible="not active"/>
                                            -->
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

            </form>

        </field>
    </record>

    <!-- TREE -->
    <record id="view_meli_account_list" model="ir.ui.view">
        <field name="name">meli.account.list</field>
        <field name="model">meli.account</field>
        <field name="arch" type="xml">

            <list>
                <field name="image_1920"
                       widget="image"
                       options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="meli_user_id"/>
                <field name="redirect_uri"/>
                <field name="active"
                       widget="boolean_toggle"/>
            </list>

        </field>
    </record>

    <!-- ACTION -->
    <record id="action_meli_account" model="ir.actions.act_window">
        <field name="name">Cuentas Mercado Libre</field>
        <field name="res_model">meli.account</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- SUBMENU -->
    <menuitem id="menu_meli_account"
              name="Cuentas"
              parent="prb_connect_to_mercado_libre.menu_meli_config"
              action="action_meli_account"
              sequence="1"/>

</odoo>