<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meli_attribute_view_form" model="ir.ui.view">
        <field name="name">meli.attribute.view.form</field>
        <field name="model">meli.attribute</field>
        <field name="arch" type="xml">
            <form string="Atributo Categorias">
                <header>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="meli_attribute_id"/>
                            <field name="name"/>
                            <field name="required"/>
                            <field name="value_type"/>
                        </group>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <record id="meli_attribute_view_list" model="ir.ui.view">
        <field name="name">meli.attribute.view.list</field>
        <field name="model">meli.attribute</field>
        <field name="arch" type="xml">
            <list string="Atributo Categorias">
                <field name="category_id"/>
                <field name="meli_attribute_id"/>
                <field name="name"/>
                <field name="required"/>
                <field name="value_type"/>
            </list>
        </field>
    </record>


    <record id="meli_attribute_view_action" model="ir.actions.act_window">
        <field name="name">Atributo Categorias</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">meli.attribute</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registos creados, crea el primero.
            </p>
        </field>
    </record>

    <menuitem name="Atributo Categorias"
              id="meli_attribute_menu"
              parent="prb_connect_to_mercado_libre.menu_stock_config_settings_meli"
              sequence="2"
              action="meli_attribute_view_action"/>
</odoo>