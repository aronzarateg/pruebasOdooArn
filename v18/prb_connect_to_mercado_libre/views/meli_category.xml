<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="meli_category_view_form" model="ir.ui.view">
        <field name="name">meli.category.view.form</field>
        <field name="model">meli.category</field>
        <field name="arch" type="xml">
            <form string=" Categorias">
                <header>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="meli_category_id"/>
                            <field name="domain_id"/>
                            <field name="domain_name"/>
                            <field name="odoo_category_id"/>

                            <field name="account_id"/>
                            <field name="parent_id"/>
                            <field name="child_ids"/>
                            <field name="is_leaf"/>
                            <field name="path_from_root"/>
                        </group>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <record id="meli_category_view_list" model="ir.ui.view">
        <field name="name">meli.category.view.list</field>
        <field name="model">meli.category</field>
        <field name="arch" type="xml">
            <list string=" Categorias">
                <field name="name"/>
                <field name="meli_category_id"/>
                <field name="domain_id"/>
                <field name="domain_name"/>
                <field name="odoo_category_id"/>
            </list>
        </field>
    </record>


    <record id="meli_category_view_action" model="ir.actions.act_window">
        <field name="name">Categorias</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">meli.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registos creados, crea el primero.
            </p>
        </field>
    </record>

    <menuitem name="Categorias"
              id="meli_category_menu"
              parent="prb_connect_to_mercado_libre.menu_stock_config_settings_meli"
              sequence="1"
              action="meli_category_view_action"/>
</odoo>