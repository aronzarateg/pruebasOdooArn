<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meli_order_list" model="ir.ui.view">
        <field name="name">meli.order.list</field>
        <field name="model">meli.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="meli_order_id"/>
                <field name="status"/>
                <field name="buyer_nickname"/>
                <field name="total_amount"/>
                <field name="account_id"/>
            </list>
        </field>
    </record>

    <record id="view_meli_order_form" model="ir.ui.view">
        <field name="name">meli.order.form</field>
        <field name="model">meli.order</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="account_id"/>
                        <field name="meli_order_id"/>
                        <field name="status"/>
                        <field name="buyer_nickname"/>
                        <field name="total_amount"/>
                    </group>
                    <group>
                        <field name="raw_data"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_meli_order" model="ir.actions.act_window">
        <field name="name">Órdenes Mercado Libre</field>
        <field name="res_model">meli.order</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_meli_order"
              name="Órdenes"
              parent="prb_connect_to_mercado_libre.menu_meli_root"
              action="action_meli_order"
              sequence="20"/>
</odoo>