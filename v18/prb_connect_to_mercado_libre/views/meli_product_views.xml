<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list VIEW -->
    <record id="view_meli_product_list" model="ir.ui.view">
        <field name="name">meli.product.list</field>
        <field name="model">meli.product</field>
        <field name="arch" type="xml">

            <list>
                <field name="meli_item_id"/>
                <field name="title"/>
                <field name="status"/>
                <field name="price"/>
                <field name="available_quantity"/>
                <field name="account_id"/>
            </list>

        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_meli_product_form" model="ir.ui.view">
        <field name="name">meli.product.form</field>
        <field name="model">meli.product</field>
        <field name="arch" type="xml">

            <form string="Producto Mercado Libre">

                <sheet>

                    <group>
                        <field name="account_id"/>
                        <field name="product_id"/>
                        <field name="meli_item_id"/>
                        <field name="title"/>
                    </group>

                    <group>
                        <field name="status"/>
                        <field name="price"/>
                        <field name="available_quantity"/>
                        <field name="permalink" widget="url"/>
                        <field name="last_sync"/>
                    </group>

                    <group string="Errores">
                        <field name="sync_error"/>
                    </group>

                    <notebook>

                        <page string="JSON Mercado Libre">

                            <field name="raw_data"
                                   nolabel="1"
                                   widget="text"/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>
    </record>

    <!-- ACTION -->
    <record id="action_meli_product" model="ir.actions.act_window">
        <field name="name">Productos Mercado Libre</field>
        <field name="res_model">meli.product</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_meli_product"
              name="Productos"
              parent="prb_connect_to_mercado_libre.menu_meli_root"
              action="action_meli_product"
              sequence="30"/>

</odoo>