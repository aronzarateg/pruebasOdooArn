<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meli_publication_form" model="ir.ui.view">
        <field name="name">meli.publication.form</field>
        <field name="model">meli.publication</field>
        <field name="arch" type="xml">
            <form string="Publicación Mercado Libre">

                <header>

                    <button name="action_load_required_attributes"
                            type="object"
                            string="Cargar atributos"
                            class="oe_highlight"/>

                    <button name="action_publish_meli"
                            type="object"
                            string="Publicar"
                            class="btn-primary"
                            invisible="meli_item_id"/>

                    <field name="status" widget="statusbar"/>

                </header>

                <sheet>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="account_id"/>
                            <field name="product_tmpl_id"/>
                            <field name="category_id"/>
                        </group>

                        <group>
                            <field name="price"/>
                            <field name="available_quantity"/>
                            <field name="condition"/>
                            <field name="listing_type_id"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Atributos">

                            <field name="attribute_ids">

                                <list editable="bottom">
                                    <field name="attribute_id"/>
                                    <field name="value_name"/>
                                    <field name="value_id"/>
                                </list>

                            </field>

                        </page>

                        <page string="Información ML">

                            <group>
                                <field name="meli_item_id" readonly="1"/>
                                <field name="last_error" readonly="1"/>
                            </group>

                        </page>

                    </notebook>

                </sheet>

            </form>
        </field>
    </record>

    <record id="view_meli_publication_list" model="ir.ui.view">
        <field name="name">meli.publication.list</field>
        <field name="model">meli.publication</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_tmpl_id"/>
                <field name="account_id"/>
                <field name="category_id"/>
                <field name="meli_item_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>


    <record id="action_meli_publication" model="ir.actions.act_window">
        <field name="name">Publicaciones</field>
        <field name="res_model">meli.publication</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registos creados, crea el primero.
            </p>
        </field>
    </record>

    <menuitem name="Publicación"
              id="meli_publication_menu"
              parent="prb_connect_to_mercado_libre.menu_publications_config"
              sequence="1"
              action="action_meli_publication"/>
</odoo>