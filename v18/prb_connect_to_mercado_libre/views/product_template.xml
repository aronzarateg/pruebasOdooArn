<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ih_meli_product_template_form_view" model="ir.ui.view">
        <field name="name">ih.meli.product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">

                <button name="action_open_meli_publications"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart">

                    <field name="publication_count"
                           widget="statinfo"
                           string="Publicaciones"/>

                </button>

            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Mercado libre - informacion" name="meli_information">
                    <group>
                        <group name="group_general">
                            <button name="action_create_meli_publication"
                                    type="object"
                                    string="Crear Publicación ML"
                                    class="oe_highlight"/>
                        </group>
                    </group>
                </page>
            </xpath>

        </field>
    </record>
</odoo>


