<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ih_meli_product_template_form_view" model="ir.ui.view">
        <field name="name">ih.meli.product.template.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_publish_meli"
                        string="Publicar en Mercado Libre"
                        type="object"
                        class="btn-primary"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Mercado libre - informacion" name="meli_information">
                    <group>
                        <group name="group_general">
                            <field name="meli_category_id"/>
                            <field name="meli_brand"/>
                            <field name="meli_model"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>


