<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_shopify_refresh_tokens" model="ir.cron">
        <field name="name">Shopify: Renovar tokens</field>
        <field name="model_id" ref="model_shopify_account"/>
        <field name="state">code</field>
        <field name="code">model.cron_refresh_tokens()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_sync_shopify_orders" model="ir.cron">
        <field name="name">Shopify: sincronizar órdenes</field>
        <field name="model_id" ref="model_shopify_account"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_shopify_orders()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

</odoo>