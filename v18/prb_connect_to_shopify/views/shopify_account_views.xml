<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list -->
    <record id="view_shopify_account_list" model="ir.ui.view">
        <field name="name">shopify.account.list</field>
        <field name="model">shopify.account</field>
        <field name="arch" type="xml">
            <list>

                <field name="name"/>
                <field name="shop"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_shopify_account_form" model="ir.ui.view">
        <field name="name">shopify.account.form</field>
        <field name="model">shopify.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta Shopify">

                <header>
                    <button name="action_connect_shopify"
                            string="Conectar Shopify"
                            type="object"
                            class="oe_highlight"/>

                    <button name="action_test_connection"
                            string="Probar conexión"
                            type="object"
                            invisible="not access_token"/>

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>

                    <field name="image_1920"
                           widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'image_1920'}"/>
                    <group>

                        <group>
                            <field name="name"/>
                            <field name="shop"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="redirect_uri"/>
                            <field name="active"/>
                        </group>

                        <group string="OAuth">
                            <field name="access_token" readonly="1" password="True"/>
                            <field name="scopes" readonly="1"/>

                            <field name="refresh_token" readonly="1"/>
                            <field name="refresh_token_expiration_date" readonly="1"/>
                            <field name="token_expires_in" readonly="1"/>
                            <field name="token_expiration_date" readonly="1"/>
                            <field name="last_token_refresh" readonly="1"/>
                            <field name="token_error" readonly="1"/>
                            <field name="webhook_callback_url" readonly="1"/>
                            <field name="webhook_last_sync" readonly="1"/>
                            <field name="webhook_sync_message" readonly="1"/>
                        </group>

                    </group>
                    <notebook>
                        <page string="Sincronizaciones">
                            <group>
                                <group string="Órdenes Shopify"
                                       invisible="not active or state != 'connected'">

                                    <group>
                                        <field name="order_limit"/>
                                        <field name="last_order_sync" readonly="1"/>
                                    </group>

                                    <group>
                                        <button name="action_get_shopify_orders"
                                                string="Consultar órdenes"
                                                type="object"
                                                class="oe_highlight"
                                                icon="fa-shopping-cart"/>
                                    </group>

                                </group>
                                <group string="Webhooks">
                                    <field
                                            name="webhook_callback_url"
                                            placeholder="https://dominio.com/shopify/webhooks"
                                    />

                                    <field name="webhook_last_sync" readonly="1"/>

                                    <button
                                            name="action_sync_webhooks"
                                            type="object"
                                            string="Sincronizar Webhooks"
                                            class="btn-primary"
                                            icon="fa-refresh"
                                    />

                                    <field
                                            name="webhook_sync_message"
                                            readonly="1"
                                            nolabel="1"
                                    />
                                </group>
                            </group>


                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_shopify_account" model="ir.actions.act_window">
        <field name="name">Cuentas Shopify</field>
        <field name="res_model">shopify.account</field>
        <field name="res_model">shopify.account</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Submenú -->
    <menuitem id="menu_shopify_accounts"
              name="Cuentas"
              parent="prb_connect_to_shopify.menu_shopify_config"
              action="action_shopify_account"
              sequence="1"/>

</odoo>
