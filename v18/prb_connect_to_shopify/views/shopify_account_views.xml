<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- list -->
    <record id="view_shopify_account_list" model="ir.ui.view">
        <field name="name">shopify.account.list</field>
        <field name="model">shopify.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="shop"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_shopify_account_form" model="ir.ui.view">
        <field name="name">shopify.account.form</field>
        <field name="model">shopify.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta Shopify">

                <header>
                    <button name="action_connect_shopify"
                            string="Conectar Shopify"
                            type="object"
                            class="oe_highlight"/>

                    <button name="action_test_connection"
                            string="Probar conexión"
                            type="object"
                            invisible="not access_token"/>

                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="name"/>
                            <field name="shop"/>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="redirect_uri"/>
                        </group>

                        <group string="OAuth">
                            <field name="access_token" readonly="1" password="True"/>
                            <field name="scopes" readonly="1"/>
                        </group>

                    </group>

                </sheet>

            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_shopify_account" model="ir.actions.act_window">
        <field name="name">Cuentas Shopify</field>
        <field name="res_model">shopify.account</field>
        <field name="res_model">shopify.account</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Submenú -->
    <menuitem id="menu_shopify_accounts"
              name="Cuentas Shopify"
              parent="prb_connect_to_shopify.menu_shopify_root"
               action="action_shopify_account"
              sequence="1"/>

</odoo>
