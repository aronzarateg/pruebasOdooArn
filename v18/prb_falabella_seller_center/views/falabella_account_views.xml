<odoo>

    <record id="view_falabella_account_tree" model="ir.ui.view">
        <field name="name">falabella.account.tree</field>
        <field name="model">falabella.account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_id_api"/>
                <field name="api_url"/>
                <field name="format"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_falabella_account_form" model="ir.ui.view">
        <field name="name">falabella.account.form</field>
        <field name="model">falabella.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta Falabella">
                <header>
                    <button name="action_test_connection"
                            type="object"
                            string="Probar conexión"
                            class="oe_highlight"/>

                    <button name="action_get_brands"
                            type="object"
                            string="Consultar marcas"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id_api"/>
                            <field name="api_key" password="True"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="api_url"/>
                            <field name="version"/>
                            <field name="format"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Última respuesta">
                            <field name="last_response" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_falabella_account" model="ir.actions.act_window">
        <field name="name">Cuentas Falabella</field>
        <field name="res_model">falabella.account</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>