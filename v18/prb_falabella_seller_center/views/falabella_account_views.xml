<odoo>
    <record id="view_falabella_account_search" model="ir.ui.view">
        <field name="name">falabella.account.search</field>
        <field name="model">falabella.account</field>
        <field name="arch" type="xml">
            <search string="Buscar cuentas Falabella">
                <field name="name"/>
                <field name="user_id_api"/>
                <field name="api_url"/>

                <separator/>

                <filter name="active_accounts"
                        string="Activas"
                        domain="[('active', '=', True)]"/>

                <filter name="archived_accounts"
                        string="Archivadas"
                        domain="[('active', '=', False)]"/>

                <group expand="0" string="Agrupar por">
                    <filter name="group_format"
                            string="Formato"
                            context="{'group_by': 'format'}"/>

                    <filter name="group_active"
                            string="Estado"
                            context="{'group_by': 'active'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_falabella_account_list" model="ir.ui.view">
        <field name="name">falabella.account.list</field>
        <field name="model">falabella.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="image_1920"
                       widget="image"
                       options="{'size': [40, 40]}"/>
                <field name="name"/>
                <field name="user_id_api"/>
                <field name="api_url"/>
                <field name="format"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_falabella_account_form" model="ir.ui.view">
        <field name="name">falabella.account.form</field>
        <field name="model">falabella.account</field>
        <field name="arch" type="xml">
            <form string="Cuenta Falabella">
                <header>
                    <button name="action_test_connection"
                            type="object"
                            string="Probar conexión"
                            class="oe_highlight"/>

                    <button name="action_sync_orders"
                            type="object"
                            string="Sincronizar órdenes"
                            class="btn-primary"/>

                    <!--<button name="action_sync_brands"
                            type="object"
                            string="Sincronizar marcas"
                            class="oe_highlight"/>
                        <button name="action_sync_categories"
                            type="object"
                            string="Sincronizar categorías"
                            class="btn-secondary"/>
                        <button name="action_sync_category_attributes"
                                type="object"
                                string="Sincronizar atributos"
                                class="btn-primary"/>
                            -->
                </header>

                <sheet>
                    <field name="active" invisible="1"/>

                    <widget name="web_ribbon"
                            title="Archivado"
                            bg_color="text-bg-danger"
                            invisible="active"/>

                    <field name="image_1920"
                           widget="image"
                           class="oe_avatar"
                           options="{
                           'preview_image': 'image_1920',
                           'size': [128, 128]
                       }"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Nombre de la cuenta"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id_api"/>
                            <field name="api_key" password="True"/>
                            <field name="active"/>
                        </group>

                        <group>
                            <field name="api_url"/>
                            <field name="version"/>
                            <field name="format"/>
                        </group>
                    </group>

                    <!--<notebook>
                        <page string="Última respuesta">
                            <field name="last_response" nolabel="1"/>
                        </page>
                    </notebook>-->
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_falabella_account" model="ir.actions.act_window">
        <field name="name">Cuentas Falabella</field>
        <field name="res_model">falabella.account</field>
        <field name="view_mode">list,form</field>
         <field name="context">
        {
            'active_test': False,
            'search_default_active_accounts': 1
        }
    </field>
    </record>
    <menuitem id="menu_falabella_accounts"
              name="Cuentas"
              parent="prb_falabella_seller_center.menu_falabella_config"
              action="action_falabella_account"
              sequence="10"/>

</odoo>