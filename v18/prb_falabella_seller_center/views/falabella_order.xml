<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_falabella_order_list" model="ir.ui.view">
        <field name="name">falabella.order.list</field>
        <field name="model">falabella.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="account_id" optional="show"/>
                <field name="sale_order_id" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="order_number" optional="show"/>
                <field name="customer_name" optional="show"/>
                <field name="customer_document" optional="show"/>
                <field name="status" optional="show"/>
                <field name="grand_total" optional="show"/>
                <field name="created_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_falabella_order_form" model="ir.ui.view">
        <field name="name">falabella.order.form</field>
        <field name="model">falabella.order</field>
        <field name="arch" type="xml">
            <form string="Ordenes Falabella">
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="sale_order_id"/>
                            <field name="order_id"/>
                            <field name="order_number"/>
                            <field name="customer_name"/>
                        </group>
                        <group>
                            <field name="customer_document"/>
                            <field name="status"/>
                            <field name="grand_total"/>
                            <field name="created_at"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Líneas">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="order_id"/>
                                    <field name="seller_sku"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                </list>
                            </field>
                        </page>

                        <page string="Respuesta original">
                            <field name="raw_response" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_falabella_order" model="ir.actions.act_window">
        <field name="name">Ordenes Falabella</field>
        <field name="res_model">falabella.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_falabella_orders"
              name="Ordenes"
              parent="prb_falabella_seller_center.menu_falabella_syncs"
              action="action_falabella_order"
              sequence="2"/>

</odoo>