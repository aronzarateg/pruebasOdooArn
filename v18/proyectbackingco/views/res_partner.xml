<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ih_backingco_base_view_partner_form" model="ir.ui.view">
            <field name="name">ih.backingco.base.view.partner.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object" name="view_info">
                        <field string="Crédito" name="desc_credito" widget="statinfo"/>
                    </button>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page name="inf_adittional" string="Información adicional">
                        <group>
                            <field name="is_credit"/>
                            <field name="date_credit_start"/>
                            <field name="date_credit_end"/>
                            <field name="amount_credit"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>


